{
  "types": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactoring" },
    { "type": "docs", "section": "Documentation" },
    { "type": "build", "section": "Build System" },
    { "type": "ci", "section": "CI/CD" },
    { "type": "chore", "hidden": true },
    { "type": "style", "hidden": true },
    { "type": "test", "hidden": true }
  ],
  "packageFiles": [
    { "filename": "package.json", "type": "json" }
  ],
  "bumpFiles": [
    { "filename": "package.json", "type": "json" },
    { "filename": "package-lock.json", "type": "json" },
    { "filename": "web/package.json", "type": "json" },
    { "filename": "web/package-lock.json", "type": "json" },
    { "filename": "core/Cargo.toml", "updater": "scripts/cargo-updater.cjs" },
    { "filename": "core/Cargo.lock", "updater": "scripts/cargo-updater.cjs" }
  ],
  "releaseCommitMessageFormat": "chore(release): v{{currentTag}}"
}
