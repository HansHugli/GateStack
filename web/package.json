{
  "name": "gatestack",
  "version": "4.0.0",
  "description": "GateStack — Visual 32-bit Computer Simulator",
  "author": "Hans",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "tsc && vite build && node -e \"const fs=require('fs');fs.copyFileSync('electron/main.mjs','main.mjs');fs.copyFileSync('electron/preload.cjs','preload.cjs');\"",
    "build:wasm": "cd ../core && wasm-pack build --target web --out-dir ../web/src/wasm",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "clean:release": "node -e \"const fs=require('fs'),p=require('path'),d=p.join(__dirname,'release');if(fs.existsSync(d)){for(let i=0;i<5;i++){try{fs.rmSync(d,{recursive:true,force:true});break}catch(e){if(i===4)throw e;const w=Date.now();while(Date.now()-w<2000){}}}}\"",
    "electron:build": "npm run build && npm run clean:release && electron-builder",
    "electron:build:win": "npm run build && npm run clean:release && electron-builder --win",
    "electron:build:mac": "npm run build && npm run clean:release && electron-builder --mac",
    "electron:build:linux": "npm run build && npm run clean:release && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-wasm": "^3.3.0",
    "vite-plugin-top-level-await": "^1.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.gatestack.simulator",
    "productName": "GateStack",
    "copyright": "Copyright © 2026 Hans",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "dist",
      "main.mjs",
      "preload.cjs"
    ],
    "extraMetadata": {
      "main": "main.mjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GateStack"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build/icon.png",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build/icon.png",
      "category": "Education"
    }
  }
}
